# Copy this file to .env for local runs. On Vercel, add these under
# Project -> Settings -> Environment Variables instead.
#
# Set at least ONE of the two keys below. If both are set, the free
# OpenRouter tier is tried first and Hugging Face is the fallback.

# Option 1 (free): OpenRouter serves the same open Gemma 4 model at no cost,
# limited to 20 requests/minute and 50/day (1000/day once you have bought $10 of credits).
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Option 2 (paid): Hugging Face Inference Providers. Free HF accounts get no
# monthly credits; add credits at https://huggingface.co/settings/billing
# Token: https://huggingface.co/settings/tokens (fine-grained, tick
# "Make calls to Inference Providers").
HF_TOKEN=
VLM_MODELS=google/gemma-4-26B-A4B-it,Qwen/Qwen3-VL-8B-Instruct
HF_PROVIDER=auto

# Below this confidence the app asks the user to confirm the item.
CONFIDENCE_THRESHOLD=0.6

# IN-KL = Kerala, IN = rest of India.
DEFAULT_REGION=IN-KL

# Set to 1 to run the UI without calling any model (canned answers).
MOCK_VLM=0
