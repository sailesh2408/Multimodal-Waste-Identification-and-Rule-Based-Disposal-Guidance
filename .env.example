# Copy this file to .env and fill in your token.
# Create a token at https://huggingface.co/settings/tokens
# (fine-grained, with "Make calls to Inference Providers" enabled).
HF_TOKEN=

# Vision-language models to try, in order. The first one that answers is used.
VLM_MODELS=google/gemma-4-26B-A4B-it,Qwen/Qwen3-VL-8B-Instruct

# "auto" lets Hugging Face pick a live provider for the model.
HF_PROVIDER=auto

# Below this confidence the app asks the user to confirm the item.
CONFIDENCE_THRESHOLD=0.6

# IN-KL = Kerala, IN = other Indian states.
DEFAULT_REGION=IN-KL

# Set to 1 to run the UI without calling Hugging Face (canned answers).
MOCK_VLM=0
